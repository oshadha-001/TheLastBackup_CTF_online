{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,tools/**,docs/**,__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]
    }
  ]
}
